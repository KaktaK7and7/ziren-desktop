{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8787 https://www.ziren.store",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "externalBin": ["binaries/assistant-core"],
    "resources": {
      "resources/": ""
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
